generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  OUT_OF_STOCK
}

enum OrderStatus {
  PAYMENT_PENDING
  CONFIRMED
  ORDERED_FROM_SOURCE
  SHIPPED
  DELIVERED
  CANCELLED
  RTO
  RETURN_REQUESTED
  REFUNDED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  accessRole  String   @default("STAFF")
  permissions Json?
  isActive    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  adminEmail  String
  action      String
  entityType  String
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([adminEmail, createdAt])
  @@index([entityType, entityId])
}

model AdminApproval {
  id             String   @id @default(cuid())
  requestedById  String
  requestedBy    String
  action         String
  entityType     String
  entityId       String?
  payload        Json
  status         String   @default("PENDING")
  reviewedBy     String?
  reviewNote     String?
  createdAt      DateTime @default(now())
  reviewedAt     DateTime?

  @@index([status, createdAt])
  @@index([requestedBy, createdAt])
}

model CustomerUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  addresses    CustomerAddress[]
  wishlists    Wishlist[]
  recentlyViewed RecentlyViewed[]
  supportTickets SupportTicket[]
  stockAlerts StockAlert[]
}

model CustomerAddress {
  id           String       @id @default(cuid())
  customerId   String
  customer     CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label        String       @default("Home")
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  district     String
  state        String
  pinCode      String
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([customerId])
  @@index([customerId, isDefault])
}

model SignupOtp {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  otpHash      String
  expiresAt    DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model PasswordResetOtp {
  id           String   @id @default(cuid())
  email        String   @unique
  otpHash      String
  expiresAt    DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  pricingRules PricingRule[]
}

model Product {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  description         String?
  metaTitle           String?
  metaDescription     String?
  canonicalUrl        String?
  sourceUrl           String?
  sourceCost          Decimal?             @db.Decimal(12, 2)
  sellingPrice        Decimal              @db.Decimal(12, 2)
  stock               Int                  @default(0)
  categoryId          String?
  category            Category?            @relation(fields: [categoryId], references: [id])
  featured            Boolean              @default(false)
  status              ProductStatus        @default(DRAFT)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  images              ProductImage[]
  orderItems          OrderItem[]
  inventoryMovements  InventoryMovement[]
  priceHistory        ProductPriceHistory[]
  priceLocked         Boolean              @default(false)
  priceLockValue      Decimal?             @db.Decimal(12, 2)
  marketplaceProducts MarketplaceProduct[]
  reviews             ProductReview[]
  versions            ProductVersion[]
  stockAlerts StockAlert[]
  wishlists           Wishlist[]
  recentlyViewed      RecentlyViewed[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
}


model PricingRule {
  id             String   @id @default(cuid())
  name           String
  scope          String   @default("GLOBAL")
  provider       String?
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  markupPercent  Decimal  @db.Decimal(7, 2)
  fixedAmount    Decimal  @default(0) @db.Decimal(12, 2)
  minPrice       Decimal? @db.Decimal(12, 2)
  maxPrice       Decimal? @db.Decimal(12, 2)
  roundingMode   String   @default("NONE")
  roundingValue  Decimal? @db.Decimal(12, 2)
  enabled        Boolean  @default(true)
  priority       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([scope, enabled, priority])
  @@index([provider, enabled])
  @@index([categoryId, enabled])
}

model ProductPriceHistory {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceCost     Decimal? @db.Decimal(12, 2)
  oldSellingPrice Decimal @db.Decimal(12, 2)
  newSellingPrice Decimal @db.Decimal(12, 2)
  markupPercent  Decimal? @db.Decimal(7, 2)
  reason         String
  changedBy      String
  createdAt      DateTime @default(now())

  @@index([productId, createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model OrderCounter {
  id    Int @id @default(1)
  value Int @default(0)
}

model RazorpayWebhookEvent {
  id              String    @id @default(cuid())
  eventId         String   @unique
  event           String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  processingError String?

  @@index([event])
  @@index([receivedAt])
}

model InventoryMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  quantity  Int
  reason    String
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([reason])
}

model Order {
  id                      String               @id @default(uuid())
  orderNumber             String               @unique
  customerName            String
  email                   String?
  phone                   String
  addressLine1            String
  addressLine2            String?
  landmark                String?
  city                    String
  district                String
  pinCode                 String
  state                   String
  totalAmount             Decimal              @db.Decimal(12, 2)
  deliveryCharge          Decimal              @db.Decimal(12, 2)
  status                  OrderStatus          @default(PAYMENT_PENDING)
  paymentMethod           String               @default("UPI_MANUAL")
  razorpayOrderId         String?              @unique
  razorpayPaymentId       String?              @unique
  razorpaySignature       String?
  upiTransactionId        String?              @unique
  paymentScreenshotUrl    String?
  paymentVerifiedAt      DateTime?
  paymentVerifiedBy      String?
  paymentVerificationNote String?
  paymentRejectionReason  String?
  sourceOrderId           String?
  courierName             String?
  trackingNumber          String?
  trackingUrl             String?
  cancellationReason      String?
  refundAmount            Decimal?
  refundMethod            String?
  refundReference         String?
  refundProcessedAt       DateTime?
  reservationExpiresAt    DateTime?
  paymentAccessTokenHash  String?             @unique
  createdAt               DateTime             @default(now())
  deletedAt               DateTime?
  couponCode              String?
  discountAmount          Decimal              @default(0) @db.Decimal(12, 2)
  updatedAt               DateTime             @updatedAt
  items                   OrderItem[]
  history                 OrderStatusHistory[]
  inventoryMovements      InventoryMovement[]
  marketplaceOrders       MarketplaceOrder[]
  supportTickets          SupportTicket[]

  @@index([status])
  @@index([phone])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([paymentMethod])
  @@index([reservationExpiresAt])
  @@index([couponCode])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  sourceCost  Decimal? @db.Decimal(12, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  oldStatus OrderStatus?
  newStatus OrderStatus
  changedBy String
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model MarketplaceIntegration {
  id                    String   @id @default(cuid())
  provider              String   @unique
  enabled               Boolean  @default(false)
  autoSync              Boolean  @default(false)
  syncIntervalMinutes   Int      @default(60)
  lastSyncAt             DateTime?
  lastSuccessAt          DateTime?
  lastError              String?
  importedProducts      Int      @default(0)
  importedOrders        Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  products              MarketplaceProduct[]
  orders                MarketplaceOrder[]
  syncRuns              MarketplaceSyncRun[]
  importLogs            MarketplaceImportLog[]
  settings              Json?
  credentialsEncrypted  String?
  healthStatus          String   @default("UNKNOWN")
  lastSyncDurationMs    Int?
}

model MarketplaceProduct {
  id             String                 @id @default(cuid())
  integrationId String
  integration   MarketplaceIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId    String
  productId     String?
  product       Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  title         String
  sourceUrl     String?
  rawData             Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  lastSourceCost     Decimal?               @db.Decimal(12, 2)
  sourceAvailability String                 @default("UNKNOWN")
  lastCheckedAt      DateTime?
  lastCheckError     String?
  priceChanges       MarketplacePriceChange[]

  @@unique([integrationId, externalId])
  @@index([productId])
}

model MarketplaceOrder {
  id             String                 @id @default(cuid())
  integrationId String
  integration   MarketplaceIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId    String
  orderId       String?
  order         Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status        String?
  rawData       Json?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([integrationId, externalId])
  @@index([orderId])
}

model MarketplacePriceChange {
  id                 String              @id @default(cuid())
  marketplaceProductId String
  marketplaceProduct MarketplaceProduct @relation(fields: [marketplaceProductId], references: [id], onDelete: Cascade)
  previousCost       Decimal             @db.Decimal(12, 2)
  currentCost        Decimal             @db.Decimal(12, 2)
  acknowledged       Boolean             @default(false)
  createdAt          DateTime            @default(now())

  @@index([marketplaceProductId, createdAt])
  @@index([acknowledged, createdAt])
}

model MarketplaceImportLog {
  id             String                 @id @default(cuid())
  integrationId  String
  integration    MarketplaceIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  productId      String?
  externalId     String
  sourceUrl      String?
  title          String?
  status         String
  automatic      Boolean                @default(false)
  sourceCost     Decimal?               @db.Decimal(12, 2)
  sellingPrice   Decimal?               @db.Decimal(12, 2)
  importedImages Int                    @default(0)
  error          String?
  createdAt      DateTime               @default(now())

  @@index([integrationId, createdAt])
  @@index([status, createdAt])
  @@index([productId])
}

model MarketplaceSyncRun {
  id             String                 @id @default(cuid())
  integrationId String
  integration   MarketplaceIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  type           String
  status         String
  productsFound  Int                    @default(0)
  ordersFound    Int                    @default(0)
  error          String?
  startedAt      DateTime               @default(now())
  finishedAt     DateTime?

  @@index([integrationId, startedAt])
  @@index([status, startedAt])
}


model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  type           String   @default("PERCENT")
  value          Decimal  @db.Decimal(12, 2)
  minOrderAmount Decimal? @db.Decimal(12, 2)
  maxDiscount    Decimal? @db.Decimal(12, 2)
  usageLimit     Int?
  usedCount      Int      @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled, expiresAt])
}

model StoreBanner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String?
  linkUrl     String?
  buttonText  String?
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  startsAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, sortOrder])
}


model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  viewedAt  DateTime @default(now())
  user      CustomerUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
  @@index([productId, viewedAt])
}


model AdminNotification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  entityType String?
  entityId   String?
  readAt    DateTime?
  dismissedAt DateTime?
  createdAt DateTime @default(now())

  @@index([readAt, createdAt])
  @@index([dismissedAt, createdAt])
  @@index([type, createdAt])
}


model SupportTicket {
  id          String   @id @default(cuid())
  ticketNumber String  @unique
  customerId  String?
  customer    CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId     String?
  order       Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subject     String
  category    String
  message     String
  status      String   @default("OPEN")
  adminReply  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model StockAlert {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer CustomerUser? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())
  notifiedAt DateTime?

  @@unique([productId, email])
  @@index([productId, notifiedAt])
}


model Supplier {
  id           String   @id @default(cuid())
  name         String   @unique
  website      String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  products     Product[]

  @@index([status, name])
}

model ProductVersion {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  snapshot       Json
  changedBy      String
  reason         String?
  createdAt      DateTime @default(now())

  @@index([productId, createdAt])
}

model ProductReview {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   String?
  customerName String?
  customerEmail String?
  orderId      String?
  rating       Int
  title        String?
  body         String?
  status       String   @default("PENDING")
  verified    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

model CheckoutSession {
  id            String   @id @default(cuid())
  sessionKey    String   @unique
  customerId    String?
  email         String?
  cartValue     Decimal? @db.Decimal(12, 2)
  itemCount     Int      @default(0)
  status        String   @default("STARTED")
  recoveredAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model AutomationRule {
  id          String   @id @default(cuid())
  name        String   @unique
  event       String
  conditions  Json?
  actions     Json
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, event])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  enabled     Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BusinessGoal {
  id          String   @id @default(cuid())
  name        String
  metric      String
  target      Decimal  @db.Decimal(14, 2)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([metric, periodStart, periodEnd])
}

model IntegrationEvent {
  id          String   @id @default(cuid())
  provider    String
  eventType   String
  status      String
  message     String?
  payload     Json?
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@index([provider, createdAt])
  @@index([status, createdAt])
}
